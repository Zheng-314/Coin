# 虚拟环境
.venv/
.venv1/

# 前端依赖
node_modules/

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 数据库文件
backend/instance/*.db

# 日志文件
*.log

# 编辑器生成的文件
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db

# 构建产物
dist/
build/

# 缓存文件
__pycache__/
*.pyc

# 模型文件
*.pt
*.onnx

# 向量存储
vectors_stores/

# 训练图片数据（体积过大，不上传 Git）
data/images/
data/raw/
data/processed/crops/

# 前端 Vite 缓存
frontend/.vite/

# 测试和日志
backend/benchmark_result.json
backend_startup.log

# 废弃虚拟环境
venv_py312/
venv_py313/
.venv1/
.gstack/

# 安装包与工具二进制（构建产物，不入库）
*.apk
tools/*.exe

# 前端同源伺服的构建产物（由 npm run build 生成）
/web/

# HF Space 数据构件与根 data/ 重复；instance/ 为运行时数据库
hf-space/data/
hf-space/backend/instance/

# 误建的临时文件（bash 下 `ping > nul` 产物）
/nul
